\contentsline {figure}{\numberline {2.1}{\ignorespaces End-to-end SfM pipeline: feature extraction and matching, geometric verification, incremental camera/point estimation, and bundle adjustment.}}{13}{figure.caption.4}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces Difference-of-Gaussians (DoG) used for scale-space extrema detection in SIFT.}}{14}{figure.caption.6}%
\contentsline {figure}{\numberline {2.3}{\ignorespaces SIFT keypoints detected over an image, before geometric matching across views.}}{15}{figure.caption.8}%
\contentsline {figure}{\numberline {2.4}{\ignorespaces Example of SIFT keypoint correspondences between two views used for geometric verification and triangulation.}}{15}{figure.caption.9}%
\contentsline {figure}{\numberline {2.5}{\ignorespaces Two-view epipolar geometry with baseline, epipoles, and epipolar lines satisfying $x_2^\top F x_1=0$.}}{16}{figure.caption.13}%
\contentsline {figure}{\numberline {2.6}{\ignorespaces NeRF ray-based rendering: sample evaluation along rays and volumetric compositing of color and density.}}{20}{figure.caption.21}%
\contentsline {figure}{\numberline {2.7}{\ignorespaces Representative qualitative reconstruction/rendering result obtained with 3D Gaussian Splatting.}}{21}{figure.caption.25}%
\contentsline {figure}{\numberline {2.8}{\ignorespaces 3DGS pipeline: SfM-based data processing, Gaussian initialization, splatting-based rendering and alpha compositing, differentiable optimization of Gaussian parameters, adaptive density control (clone, split, prune), tile-based rasterization for efficient screen-space processing.}}{22}{figure.caption.27}%
\contentsline {figure}{\numberline {2.9}{\ignorespaces Surface splatting: each point is associated with a local surface element (surfel) that projects to an elliptical footprint.}}{23}{figure.caption.30}%
\contentsline {figure}{\numberline {2.10}{\ignorespaces Single anisotropic 3D Gaussian primitive and its geometric parameters (center, covariance shape, and orientation).}}{24}{figure.caption.33}%
\contentsline {figure}{\numberline {2.11}{\ignorespaces Multi-view projections involved in 3D Gaussian Splatting, relating camera observations to projected Gaussian structure.}}{25}{figure.caption.35}%
\contentsline {figure}{\numberline {2.12}{\ignorespaces Front-to-back alpha compositing intuition for accumulating Gaussian contributions along visibility order.}}{28}{figure.caption.41}%
\contentsline {figure}{\numberline {2.13}{\ignorespaces Adaptive density control in 3DGS (clone/split/prune) to improve coverage and local geometric detail.}}{30}{figure.caption.44}%
\contentsline {figure}{\numberline {2.14}{\ignorespaces 3D Gaussian Splatting rendering flow: Gaussian parameterization, projection to screen-space ellipses, tile assignment, depth sorting, and compositing.}}{30}{figure.caption.46}%
\contentsline {figure}{\numberline {2.15}{\ignorespaces Example of floating Gaussians (floaters): primitives that reduce $\mathcal {L}_{\mathrm {rgb}}$ where they are seen but sit at geometrically invalid 3D locations.}}{31}{figure.caption.48}%
\contentsline {figure}{\numberline {2.16}{\ignorespaces Depth Anything 3 architecture (adapted from \cite {lin2025depthanything3}). $N$ input views are patch-embedded and processed by a DINO transformer with alternating within-view ($L_s$) and cross-view ($L_g$) self-attention. A dual-DPT head predicts per-view depth and ray maps; depth is supervised against a teacher model ($\mathcal {L}_D$), while ray maps and lifted 3D points are trained with $\mathcal {L}_M$ and $\mathcal {L}_P$. When camera parameters are unknown, a learnable camera token feeds an optional pose decoder ($\mathcal {L}_C$).}}{35}{figure.caption.57}%
\contentsline {figure}{\numberline {2.17}{\ignorespaces B\'ezier curve example with control polygon and resulting smooth trajectory, illustrating Bernstein interpolation and convex-hull behavior.}}{37}{figure.caption.62}%
\contentsline {figure}{\numberline {2.18}{\ignorespaces Tensor-product B\'ezier surface with control net: variation along $(u,v)$ generates a smooth parametric patch in $\mathbb {R}^3$.}}{38}{figure.caption.65}%
\contentsline {figure}{\numberline {2.19}{\ignorespaces Grounding DINO architecture overview with image/text encoders, cross-modal fusion, and language-guided detection outputs.}}{41}{figure.caption.72}%
\contentsline {figure}{\numberline {2.20}{\ignorespaces SAM~2 streaming architecture with memory bank and memory attention for promptable segmentation across frames.}}{43}{figure.caption.79}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {3.1}{\ignorespaces Nerfstudio training pipeline}}{45}{figure.caption.82}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {4.1}{\ignorespaces Baseline Splatfacto checkpoint exported and inspected in \textbf {SuperSplat} \cite {supersplat2024}, a web-based 3DGS viewer (\url {https://superspl.at/}). \textbf {Top left:} scene render with semi-transparent Gaussian splats (unstructured early or diagnostic view). \textbf {Top right:} shaded RGB rendering of the reconstructed scene. \textbf {Bottom left:} Gaussian \emph {centers} visualized as point sprites (``puntini'') overlaid on the render. \textbf {Bottom right:} anisotropic Gaussian \emph {ellipsoids} drawn with wireframe contours, showing the extent and orientation of each primitive.}}{48}{figure.caption.83}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Expected depth $d^{\mathrm {exp}}$ from the baseline rasterizer (\texttt {RGB+ED}), visualized in the Nerfstudio viewer as a false-color map together with the training camera poses. Closer surfaces appear in cooler colors and farther ones in warmer colors (default \texttt {turbo} colormap); background and low-accumulation pixels remain dark. This map is used later as the rendered-depth target when \texttt {loss=depth} is enabled (Section~\ref {sec:depth_supervised}).}}{49}{figure.caption.84}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces Example DA3 metric depth target ($d_{\mathrm {DA3}}$) visualized in the Nerfstudio viewer for one training view. Warmer colors denote larger camera $z$-depth.}}{51}{figure.caption.86}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces Rendered RGB on held-out views after training with photometric loss (left) versus depth loss (right). Overall color layout is similar because both runs share COLMAP color initialization, even though only the left model optimizes appearance.}}{53}{figure.caption.90}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces Exported expected depth $d^{\mathrm {exp}}$ for the same scene: photometric training (left) shows sharper object silhouettes but noisier background and a narrower effective depth range; depth training (right) yields smoother background depth closer to the DA3 prior, with softer object detail.}}{54}{figure.caption.91}%
\contentsline {figure}{\numberline {4.6}{\ignorespaces SuperSplat: RGB vs.\ depth loss}}{54}{figure.caption.92}%
\contentsline {figure}{\numberline {4.7}{\ignorespaces Example SAM~2 masks obtained from a text prompt (here, a chair) on three training views. Each mask defines the image regions that vote for object labels on projected COLMAP seed points.}}{56}{figure.caption.93}%
\contentsline {figure}{\numberline {4.8}{\ignorespaces Seed outlier \emph {before} $k$-NN filtering: a single mislabeled COLMAP seed (red circle) far from the chair cluster.}}{58}{figure.caption.96}%
\contentsline {figure}{\numberline {4.9}{\ignorespaces B\'ezier-mode 3D Gaussian output when outlier seeds are not removed. \textbf {(a)} COLMAP seed point cloud with all points assigned to the object class (including outliers). \textbf {(b)} Spurious, highly anisotropic Gaussians produced from such seeds (SuperSplat).}}{58}{figure.caption.97}%
\contentsline {figure}{\numberline {4.10}{\ignorespaces Cube-mode initialization for a segmented object (classic car): COLMAP seed points (colored by SfM RGB) lie inside the object AABB $[\mathbf {b}_{\min },\mathbf {b}_{\max }]$ (semi-transparent box). The six faces of this box host the shared B\'ezier control lattice; $k\times k$ cubic patches per face are anchored to the lattice vertices merged at edges and corners.}}{63}{figure.caption.107}%
\contentsline {figure}{\numberline {4.11}{\ignorespaces Backward pass in 3D Gaussian Splatting (adapted from \cite {kerbl2023gaussian}): loss $\mathcal {L}$ $\rightarrow $ pixel color $C_i$ $\rightarrow $ opacities $\alpha _n$ and colors $c_n$ $\rightarrow $ projected 2D Gaussian $G'_n$ $\rightarrow $ 3D mean $\boldsymbol {\mu }_n$, scales $\mathbf {s}_n$, quaternion $\mathbf {q}_n$. Red arrows indicate gradient flow; black arrows the forward evaluation chain.}}{69}{figure.caption.120}%
\contentsline {figure}{\numberline {4.12}{\ignorespaces Gradient flow in B\'ezier-mode Splatfacto: standard 3DGS splatting derivatives (top) plus reparameterization $\boldsymbol {\mu }_n,\mathbf {s}_n\leftarrow \mathbf {X}_s(\mathbf {p})$ (blue) and optional texture branch (green). Dashed forward links indicate resampled scales/colors tied to the same $\mathbf {X}_s$.}}{70}{figure.caption.122}%
